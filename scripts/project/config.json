{
  "version": "0.1",
  "scripts": [
    {
      "documentation": {
        "command": "generate-login",
        "description": "generate a login account",
        "arguments": []
      },
      "environment": {
        "image": "ruby",
        "interactive": true,
        "script": "generate-login/run.sh"
      },
      "mounts": {
        "app": "/project/"
      }
    },
    {
      "documentation": {
        "command": "test-worship-harvest",
        "description": "Test: harvest 1 dummy mandataris + 1 bedienaar for one eredienst-bestuur (no publication)",
        "arguments": ["[bestuur-uri]"]
      },
      "environment": {
        "image": "node:20-bookworm",
        "interactive": true,
        "join_networks": true,
        "script": "test-worship-harvest/run.sh"
      },
      "mounts": { "app": "/data/app/" }
    },
    {
      "documentation": {
        "command": "test-worship-harvest-and-publish",
        "description": "Test: harvest 1 dummy mandataris + 1 bedienaar for one eredienst-bestuur and verify publication",
        "arguments": ["[bestuur-uri]"]
      },
      "environment": {
        "image": "node:20-bookworm",
        "interactive": true,
        "join_networks": true,
        "script": "test-worship-harvest/run-and-publish.sh"
      },
      "mounts": { "app": "/data/app/" }
    }
  ]
}
